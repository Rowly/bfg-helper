<div class="bfg-movement-planner-panel bfg-interactive-movement-panel">
  {{#if invalid}}
    <p class="notification error">{{error}}</p>
  {{else}}
    <header class="bfg-movement-heading">
      <div>
        <p class="bfg-turn-manager-kicker">Interactive movement</p>
        <h2>{{tokenName}}</h2>
        <p class="notes">{{shipClass}}</p>
      </div>
      <div class="bfg-movement-speed-badge">
        <span>Maximum</span>
        <strong>{{maximumMovementCm}} cm</strong>
      </div>
    </header>

    {{#if hasWarnings}}
      <section class="bfg-movement-warnings">
        {{#each warnings}}
          <p><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>
        {{/each}}
      </section>
    {{/if}}

    <p class="bfg-interactive-movement-instruction bfg-interactive-movement-instruction-green">
      <strong>Movement:</strong> Click the green disk to pick it up. Left-click to place it or right-click to drop it without turning.
    </p>
    {{#if turningUnavailable}}
      <div class="bfg-interactive-movement-instruction bfg-interactive-movement-instruction-red">
        <strong><i class="fa-solid fa-ban"></i> {{turningLockTitle}}</strong>
        <span>{{turningLockMessage}}</span>
      </div>
    {{else}}
      <p class="bfg-interactive-movement-instruction bfg-interactive-movement-instruction-gold">
        <strong>Turning:</strong> After placing the disk, move the pointer within the gold arc and click to set the heading. Escorts may click the gold disk at the ship to turn immediately.
      </p>
    {{/if}}

    <section class="bfg-interactive-movement-rules">
      <span>Minimum <strong>{{minimumMovementCm}} cm</strong></span>
      <span>Turn after <strong>{{minimumBeforeTurnCm}} cm</strong></span>
      <span>Turn limit <strong>{{maximumTurnDegrees}} degrees</strong></span>
      <span>Turns <strong>{{maximumTurns}}</strong></span>
    </section>

    <section class="bfg-interactive-movement-summary">
      <div><span>Planned route</span><strong data-bfg-movement-summary>Preparing path</strong></div>
      <div><span>Total movement</span><strong data-bfg-movement-distance>0 cm</strong></div>
      <div><span>Final facing</span><strong data-bfg-movement-facing>0 degrees</strong></div>
    </section>

    <label class="bfg-movement-blast-marker">
      <input type="checkbox" name="moveThroughBlastMarker" {{#if moveThroughBlastMarker}}checked{{/if}}>
      <span>Move through Blast Marker (-5 cm maximum movement)</span>
    </label>

    <p class="bfg-movement-status" data-bfg-movement-status data-status="normal">Preparing movement handles</p>

    <div class="bfg-interactive-movement-actions">
      <button type="button" data-bfg-action="reset-movement">
        <i class="fa-solid fa-arrow-rotate-left"></i> Reset path
      </button>
      <button type="button" data-bfg-action="cancel-movement">
        <i class="fa-solid fa-xmark"></i> Cancel
      </button>
      <button type="button" data-bfg-action="execute-movement" class="bfg-primary-button">
        <i class="fa-solid fa-check"></i> Confirm movement
      </button>
    </div>
  {{/if}}
</div>
