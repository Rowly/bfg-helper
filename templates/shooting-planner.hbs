<div class="bfg-shooting-planner-panel">
  {{#if invalid}}
    <p class="notification error">{{error}}</p>
  {{else}}
    <header class="bfg-shooting-heading">
      <div>
        <p class="bfg-turn-manager-kicker">Direct-fire shooting planner</p>
        <h2>{{tokenName}}</h2>
        <p class="notes">{{shipClass}}</p>
      </div>
      <div class="bfg-shooting-badge">
        <span>Target</span>
        <strong>{{targetName}}</strong>
      </div>
    </header>

    <section class="bfg-movement-context">
      <div><span>Ship fleet</span><strong>{{fleetName}}</strong></div>
      <div><span>Active fleet</span><strong>{{activeFleetName}}</strong></div>
    </section>

    {{#if hasWarnings}}
      <section class="bfg-movement-warnings">
        {{#each warnings}}
          <p><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>
        {{/each}}
      </section>
    {{/if}}

    <label class="bfg-shooting-field">
      <span>Direct-fire weapon</span>
      <select name="weaponIndex" {{#if isRolling}}disabled{{/if}}>
        {{#each weapons}}
          <option value="{{index}}" {{#if selected}}selected{{/if}} {{#if fired}}disabled{{/if}} {{#if criticallyDisabled}}disabled{{/if}}>
            {{name}} - {{type}} - {{rangeLabel}} cm - {{arcDegrees}}&deg; - Strength {{strength}}{{#if fired}} - Fired{{/if}}{{#if criticallyDisabled}} - Critically damaged{{/if}}
          </option>
        {{/each}}
      </select>
    </label>

    <label class="bfg-shooting-split-toggle">
      <input type="checkbox" name="splitFire" {{#if splitFire}}checked{{/if}} {{#if isRolling}}disabled{{/if}}>
      Split this weapon's fire between multiple targets
    </label>

    <p class="notes">
      Use Foundry's target control to select {{#if splitFire}}two or more enemy targets{{else}}exactly one enemy ship or ordnance marker{{/if}}, then check the firing solution.
    </p>

    <div class="bfg-shooting-actions">
      <button type="button" data-bfg-action="refresh-target" {{#if isRolling}}disabled{{/if}}>
        <i class="fa-solid fa-arrows-rotate"></i>
        Refresh target
      </button>
      <button type="button" data-bfg-action="check-firing-solution" class="bfg-primary-button" {{#if isRolling}}disabled{{/if}}>
        <i class="fa-solid fa-crosshairs"></i>
        Check firing solution
      </button>
    </div>

    {{#if isRolling}}
      <section class="bfg-shooting-waiting" aria-live="polite" aria-busy="true">
        <i class="fa-solid fa-dice-d6"></i>
        <strong>Rolling attack...</strong>
        <span>Resolving dice and checking for critical damage.</span>
      </section>
    {{else}}
    {{#unless hasResolution}}
    {{#if hasSplitAnalysis}}
      <section class="bfg-split-fire-summary{{#unless splitLegal}} illegal{{/unless}}">
        <h3>Split-fire allocation</h3>
        <div><span>Effective Strength or Firepower</span><strong>{{splitEffectiveStrength}}</strong></div>
        <div><span>Allocated</span><strong>{{splitAllocated}} / {{splitEffectiveStrength}}</strong></div>
        {{#each splitWarnings}}<p><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>{{/each}}
      </section>
      {{#each splitTargets}}
        <section class="bfg-split-fire-target{{#unless legal}} illegal{{/unless}}">
          <h3>{{targetName}}</h3>
          <div class="bfg-split-allocation">
            <span>Allocated strength</span>
            <button type="button" data-bfg-split-step="-1" data-target-id="{{targetId}}" aria-label="Reduce allocation">-</button>
            <strong>{{allocation}}</strong>
            <button type="button" data-bfg-split-step="1" data-target-id="{{targetId}}" aria-label="Increase allocation">+</button>
          </div>
          <div><span>Range</span><strong>{{rangeLabel}} / {{maximumRangeCm}} cm, {{#if inRange}}in range{{else}}out of range{{/if}}</strong></div>
          <div><span>Arc</span><strong>{{#if inArc}}In arc{{else}}Outside arc{{/if}}</strong></div>
          <div><span>Target</span><strong>{{targetClass}}, {{targetArmour}}</strong></div>
          {{#if targetPriorityRequired}}
            <div><span>Target priority</span><strong>Leadership test required; failure redirects to {{priorityTargetName}}</strong></div>
            <p class="notes">If redirected, use the Brace declaration entered here for {{priorityTargetName}} unless that target has its own allocation controls.</p>
          {{/if}}
          {{#if batteryCalculation}}
            <div><span>Gunnery column</span><strong>{{batteryCalculation.startingColumnLabel}}; {{shiftsLabel}}; final {{batteryCalculation.columnLabel}}</strong></div>
          {{/if}}
          <div><span>Attack dice</span><strong>{{attackDice}}d6</strong></div>
          <label><input type="checkbox" data-bfg-split-option="interveningBlastMarkers" data-target-id="{{targetId}}" {{#if options.interveningBlastMarkers}}checked{{/if}}> Intervening Blast Markers</label>
          {{#unless isOrdnance}}
            <label><input type="checkbox" data-bfg-split-option="countsAsDefences" data-target-id="{{targetId}}" {{#if options.countsAsDefences}}checked{{/if}}> Target counts as Defences</label>
            <label><input type="checkbox" data-bfg-split-option="brace" data-target-id="{{targetId}}" {{#if options.brace}}checked{{/if}}> Attempt to Brace target for Impact</label>
            <label><input type="checkbox" data-bfg-split-option="braceBlastContact" data-target-id="{{targetId}}" {{#if options.braceBlastContact}}checked{{/if}}> Target has Blast Markers in base contact</label>
          {{/unless}}
          {{#each warnings}}<p><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>{{/each}}
        </section>
      {{/each}}
      <button type="button" data-bfg-action="resolve-direct-fire" class="bfg-primary-button bfg-full-width" {{#unless splitLegal}}disabled{{/unless}}>
        <i class="fa-solid fa-dice"></i> Resolve split fire
      </button>
    {{/if}}
    {{#if hasAnalysis}}
      <section class="bfg-firing-analysis{{#unless analysis.legal}} illegal{{/unless}}">
        <div><span>Weapon type</span><strong>{{analysis.weaponType}}</strong></div>
        <div><span>Effective strength</span><strong>{{analysis.effectiveStrength}} (profile {{analysis.profileStrength}}{{#if analysis.attackerCrippled}}; crippled{{/if}}{{#if analysis.attackerSpecialOrder}}; {{analysis.attackerSpecialOrder}}{{/if}})</strong></div>
        <div><span>Measured range</span><strong>{{analysis.rangeLabel}} / {{analysis.maximumRangeCm}} cm</strong></div>
        <div><span>Range check</span><strong>{{#if analysis.inRange}}In range{{else}}Out of range{{/if}}</strong></div>
        <div><span>Arc check</span><strong>{{#if analysis.inArc}}In arc{{else}}Outside arc{{/if}}</strong></div>
        <div><span>Target facing</span><strong>{{analysis.targetFacing}}</strong></div>
        <div><span>Gunnery orientation</span><strong>{{analysis.orientation}}</strong></div>
        <div><span>Target class</span><strong>{{analysis.targetClass}}</strong></div>
        <div><span>Target armour</span><strong>{{analysis.targetArmour}}</strong></div>
        {{#unless analysis.isOrdnance}}
          <div><span>Priority target</span><strong>{{analysis.priorityTargetName}}</strong></div>
          <div><span>Leadership test</span><strong>{{#if analysis.targetPriorityRequired}}Required to retain selected target{{else}}Not required{{/if}}</strong></div>
        {{/unless}}
        {{#unless analysis.isOrdnance}}
          <div><span>Target hits</span><strong>{{analysis.targetCombatState.currentHits}}/{{analysis.targetCombatState.maximumHits}}</strong></div>
          <div><span>Target shields</span><strong>{{analysis.targetCombatState.currentShields}}/{{analysis.targetCombatState.maximumShields}}</strong></div>
        {{/unless}}
        {{#if analysis.gunneryCalculation}}
          <div><span>Base column</span><strong>{{analysis.gunneryCalculation.startingColumnLabel}}</strong></div>
          <div><span>Column shifts</span><strong>{{analysis.gunneryCalculation.shiftsLabel}}</strong></div>
          <div><span>Final column</span><strong>{{analysis.gunneryCalculation.columnLabel}}</strong></div>
        {{/if}}
        {{#if analysis.attackDice}}
          <div><span>Attack dice</span><strong>{{analysis.attackDice}}d6</strong></div>
        {{/if}}
        {{#each analysis.warnings}}
          <p><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>
        {{/each}}
      </section>

      <section class="bfg-shooting-modifiers">
        <label>
          <input type="checkbox" name="interveningBlastMarkers" {{#if interveningBlastMarkers}}checked{{/if}}>
          Intervening Blast Markers (one column right)
        </label>
        {{#unless analysis.isOrdnance}}
          <label>
            <input type="checkbox" name="countsAsDefences" {{#if countsAsDefences}}checked{{/if}}>
            Target counts as Defences
          </label>
          <label>
            <input type="checkbox" name="targetBrace">
            Attempt to Brace the target for Impact before rolling
          </label>
          <label>
            <input type="checkbox" name="targetBraceBlastContact">
            Target has Blast Markers in base contact (-1 Leadership)
          </label>
          {{#if analysis.targetPriorityRequired}}
            <p class="notes">If the firing ship fails its target-priority test, the attack is redirected to {{analysis.priorityTargetName}}.</p>
            <label>
              <input type="checkbox" name="priorityTargetBrace">
              Attempt to Brace {{analysis.priorityTargetName}} for Impact if the attack is redirected
            </label>
            <label>
              <input type="checkbox" name="priorityTargetBraceBlastContact">
              {{analysis.priorityTargetName}} has Blast Markers in base contact (-1 Leadership)
            </label>
          {{/if}}
        {{/unless}}
        <p class="notes">Range shifts are applied automatically.{{#unless analysis.isOrdnance}} Use Defences for a stationary ship that has not moved at least 5 cm.{{/unless}}</p>
        <button type="button" data-bfg-action="resolve-direct-fire" class="bfg-primary-button" {{#unless canResolveAttack}}disabled{{/unless}}>
          <i class="fa-solid fa-dice"></i>
          Resolve attack
        </button>
        {{#if hasResolution}}
          {{#if damageCommitted}}
            <p class="notification info">This weapon has fired during the current Shooting phase.</p>
          {{else}}
            <p class="notification info"><i class="fa-solid fa-hourglass-half"></i> Attack resolved. Waiting for damage confirmation.</p>
          {{/if}}
        {{else}}
          {{#unless canResolveAttack}}
            <p class="notification error">The firing solution is illegal and cannot be resolved. Gamemaster override permits inspection only.</p>
          {{/unless}}
        {{/if}}
      </section>
    {{/if}}
    {{/unless}}

    {{#if hasResolution}}
      <section class="bfg-firing-resolution">
        {{#if resolution.splitFire}}
        <h3>Split-fire result</h3>
        <div><span>Weapon</span><strong>{{resolution.weaponName}}</strong></div>
        <div><span>Effective strength</span><strong>{{resolution.effectiveStrength}}</strong></div>
        <div><span>Total hits</span><strong>{{resolution.totalHits}}</strong></div>
        <div class="bfg-split-fire-results-grid">
        {{#each resolution.results}}
          <article class="bfg-split-fire-result">
            <h4>{{targetName}}</h4>
            {{#each priorityChecks}}<div><span>Target priority</span><strong>{{dice}} = {{total}} against {{leadership}}: {{#if passed}}passed{{else}}failed; redirected from {{selectedTargetName}}{{/if}}</strong></div>{{/each}}
            <div><span>Allocation</span><strong>{{allocatedStrength}}</strong></div>
            <div><span>Dice ({{attackDice}}d6, needing {{hitTarget}}+)</span><strong>{{resultsLabel}}</strong></div>
            <div><span>Hits</span><strong>{{hits}}</strong></div>
            {{#if isOrdnance}}
              <div><span>Ordnance result</span><strong>{{#if ordnanceHit}}Marker or wave destroyed{{else}}No effect{{/if}}</strong></div>
            {{else}}
              <div><span>Shield hits</span><strong>{{damage.shieldHits}}</strong></div>
              {{#if damage.shieldHits}}<p>Place {{damage.shieldHits}} Blast Marker token(s) manually for this attack's {{damage.shieldHits}} shield hit(s).</p>{{/if}}
              <div><span>Hull damage</span><strong>{{damage.hullHits}}</strong></div>
              <div><span>Critical checks ({{damage.critical.checks}}d6, needing 6)</span><strong>{{criticalChecksLabel}}</strong></div>
              <div><span>Critical damage</span><strong>{{damage.extraCriticalDamage}}</strong></div>
              {{#each damage.critical.results}}<p><i class="fa-solid fa-burst"></i> 2D6 roll {{rolledTotal}}: {{name}}{{#if extraDamage}} - {{extraDamage}} extra damage{{/if}}</p>{{/each}}
              {{#if damage.catastrophic}}<p class="bfg-catastrophic-result"><i class="fa-solid fa-explosion"></i> {{damage.catastrophic.name}}: {{damage.catastrophic.instruction}}</p>{{/if}}
              <div><span>Remaining shields</span><strong>{{damage.after.currentShields}}</strong></div>
              <div><span>Remaining hull</span><strong>{{damage.after.currentHits}}</strong></div>
            {{/if}}
          </article>
        {{/each}}
        </div>
        {{else}}
        <h3>Attack result</h3>
        <div><span>Target</span><strong>{{resolution.targetName}}</strong></div>
        {{#if resolution.priorityCheck}}
          <div><span>Target-priority test (2d6)</span><strong>{{resolution.priorityCheck.dice}} = {{resolution.priorityCheck.total}} against {{resolution.priorityCheck.leadership}}: {{#if resolution.priorityCheck.passed}}passed{{else}}failed; attack redirected{{/if}}</strong></div>
        {{/if}}
        <div><span>Dice rolled</span><strong>{{resolution.attackDice}}d6</strong></div>
        <div><span>Required score</span><strong>{{resolution.hitTarget}}+</strong></div>
        <div><span>Die results</span><strong>{{resolution.resultsLabel}}</strong></div>
        <div><span>Hits scored</span><strong>{{resolution.hits}}</strong></div>
        {{#if resolution.isOrdnance}}
          <div><span>Ordnance result</span><strong>{{#if resolution.ordnanceHit}}Marker or wave destroyed{{else}}No effect{{/if}}</strong></div>
        {{else}}
        <div><span>Shield hits</span><strong>{{resolution.damage.shieldHits}}</strong></div>
        {{#if resolution.damage.shieldHits}}
          <p><i class="fa-solid fa-circle-exclamation"></i> Place {{resolution.damage.shieldHits}} Blast Marker token(s) manually for this attack's {{resolution.damage.shieldHits}} shield hit(s).</p>
        {{/if}}
        <div><span>Hull damage</span><strong>{{resolution.damage.hullHits}}</strong></div>
        <div><span>Critical checks ({{resolution.damage.critical.checks}}d6, needing 6)</span><strong>{{resolution.criticalChecksLabel}}</strong></div>
        <div><span>Critical damage</span><strong>{{resolution.damage.extraCriticalDamage}}</strong></div>
        {{#if resolution.damage.critical.escortDestroyed}}
          <p><i class="fa-solid fa-skull"></i> Escort destroyed by critical hit.</p>
        {{/if}}
        {{#each resolution.damage.critical.results}}
          <p><i class="fa-solid fa-burst"></i> 2D6 roll {{rolledTotal}}: {{name}}{{#if shifted}} (shifted to table result {{appliedTotal}}){{/if}}{{#if extraDamage}} - {{extraDamage}} extra damage{{/if}}</p>
        {{/each}}
        {{#if resolution.damage.catastrophic}}
          <p class="bfg-catastrophic-result"><i class="fa-solid fa-explosion"></i> Catastrophic Damage{{#if resolution.damage.catastrophic.tableTotal}} (2D6 roll {{resolution.damage.catastrophic.tableTotal}}){{/if}}: <strong>{{resolution.damage.catastrophic.name}}</strong></p>
          <p>{{resolution.damage.catastrophic.instruction}}</p>
          {{#if resolution.damage.catastrophic.explosionRangeCm}}
            <p>Place {{resolution.damage.catastrophic.blastMarkers}} Blast Marker token(s) manually.</p>
            <p>Explosion range: {{resolution.damage.catastrophic.explosionRangeCm}} cm (3D6: {{resolution.catastrophicRangeLabel}}). Lance Strength: {{resolution.damage.catastrophic.explosionStrength}}.</p>
          {{/if}}
        {{/if}}
        <div><span>Remaining shields</span><strong>{{resolution.damage.after.currentShields}}</strong></div>
        <div><span>Remaining hull</span><strong>{{resolution.damage.after.currentHits}}</strong></div>
        {{#if resolution.damage.after.crippled}}<p><i class="fa-solid fa-triangle-exclamation"></i> Target will be crippled.</p>{{/if}}
        {{#if resolution.damage.after.outOfAction}}<p><i class="fa-solid fa-skull"></i> Target will be out of action.</p>{{/if}}
        {{/if}}
        {{/if}}
        {{#if canCommitDamage}}
          <button type="button" data-bfg-action="commit-direct-fire-damage" class="bfg-primary-button">
            <i class="fa-solid fa-check"></i>
            {{#if resolution.splitFire}}Apply all split-fire results{{else}}{{#if resolution.isOrdnance}}Confirm ordnance result{{else}}Apply damage to target{{/if}}{{/if}}
          </button>
        {{else if damageCommitted}}
          <p class="bfg-resolution-committed"><i class="fa-solid fa-check"></i> {{#if resolution.isOrdnance}}Ordnance result confirmed.{{else}}Damage applied.{{/if}}</p>
        {{else}}
          <p class="notes">A Gamemaster must apply the resolved damage.</p>
        {{/if}}
      </section>
    {{/if}}
    {{/if}}

    <p class="bfg-movement-status" data-bfg-shooting-status data-status="normal">
      Select a weapon and check the firing solution before resolving the attack.
    </p>

    <button type="button" data-bfg-action="clear-firing-solution" class="bfg-full-width">
      <i class="fa-solid fa-eraser"></i>
      Clear firing solution
    </button>
  {{/if}}
</div>
