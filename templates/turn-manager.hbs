<div class="bfg-turn-manager-panel">
  <header class="bfg-turn-manager-heading">
    <div><p class="bfg-turn-manager-kicker">Battle status</p><h2>{{battleStatus}}</h2></div>
    <div class="bfg-turn-round-badge" title="Current battle round"><span>Round</span><strong>{{state.round}}</strong></div>
  </header>

  <nav class="bfg-turn-tabs" aria-label="Turn Manager sections">
    <button type="button" data-bfg-tab="management" class="{{#if managementTab}}active{{/if}}"><i class="fa-solid fa-compass"></i> Management</button>
    <button type="button" data-bfg-tab="fleets" class="{{#if fleetsTab}}active{{/if}}"><i class="fa-solid fa-people-group"></i> Fleets</button>
    <button type="button" data-bfg-tab="tools" class="{{#if toolsTab}}active{{/if}}"><i class="fa-solid fa-screwdriver-wrench"></i> Tools</button>
  </nav>

  {{#if managementTab}}
    <section class="bfg-turn-active-state" aria-label="Current turn state">
      <div><span>{{activeFleetLabel}}</span><strong>{{activeFleetName}}</strong></div>
      <div><span>Current phase</span><strong>{{currentPhaseLabel}}</strong></div>
      <div><span>Controlling player</span><strong>{{actingFleetControllerName}}</strong></div>
    </section>
    <ol class="bfg-turn-phases" aria-label="Battlefleet Gothic phase order">
      {{#each phases}}<li class="bfg-turn-phase{{#if active}} active{{/if}}"><i class="fa-solid {{icon}}" aria-hidden="true"></i><span>{{label}}</span></li>{{/each}}
    </ol>

    {{#if canManage}}
      {{#if state.battleStarted}}
        <div class="bfg-turn-primary-actions">
          <button type="button" data-bfg-action="previous"><i class="fa-solid fa-backward-step"></i> Previous</button>
          <button type="button" data-bfg-action="next" class="bfg-primary-button">Next phase <i class="fa-solid fa-forward-step"></i></button>
        </div>
      {{else}}
        <button type="button" data-bfg-action="setup" class="bfg-primary-button bfg-full-width"><i class="fa-solid fa-flag"></i> Set up and start battle</button>
      {{/if}}
    {{/if}}

    {{#if state.battleStarted}}
      <section class="bfg-phase-actions" aria-label="Current phase actions">
        <header><span>{{currentPhaseLabel}}</span><strong>Available actions</strong></header>
        {{#unless canAct}}<p class="notes bfg-turn-viewer-note">These actions are restricted to the assigned player and Gamemasters.</p>{{/unless}}
        <fieldset class="bfg-phase-action-grid" {{#unless canAct}}disabled{{/unless}}>
          {{#if movementPhase}}
            <button type="button" data-bfg-action="assign-orders"><i class="fa-solid fa-scroll"></i> Assign Orders</button>
            <button type="button" data-bfg-action="move-ship"><i class="fa-solid fa-route"></i> Move Ship</button>
            <button type="button" data-bfg-action="declare-boarding"><i class="fa-solid fa-link"></i> Declare Boarding</button>
          {{/if}}
          {{#if shootingPhase}}
            <button type="button" data-bfg-action="fire-weaponry"><i class="fa-solid fa-crosshairs"></i> Fire Weaponry</button>
            <button type="button" data-bfg-action="launch-ordnance"><i class="fa-solid fa-rocket"></i> Launch Ordnance</button>
            <button type="button" data-bfg-action="weapon-arcs"><i class="fa-solid fa-fan"></i> Show Weapon Arcs</button>
            <button type="button" data-bfg-action="clear-weapon-arcs"><i class="fa-solid fa-eraser"></i> Clear Weapon Arcs</button>
          {{/if}}
          {{#if ordnancePhase}}
            <button type="button" data-bfg-action="move-ordnance"><i class="fa-solid fa-route"></i> Move Ordnance</button>
            <button type="button" data-bfg-action="ordnance-attack"><i class="fa-solid fa-burst"></i> Ordnance Attack</button>
            <button type="button" data-bfg-action="assign-cap"><i class="fa-solid fa-shield-halved"></i> Assign Fighter CAP</button>
            <button type="button" data-bfg-action="clear-ordnance-paths"><i class="fa-solid fa-eraser"></i> Clear Ordnance Paths</button>
          {{/if}}
          {{#if endPhase}}
            <button type="button" data-bfg-action="declare-boarding"><i class="fa-solid fa-link"></i> Declare Boarding</button>
            <button type="button" data-bfg-action="resolve-boarding"><i class="fa-solid fa-hand-fist"></i> Resolve Boarding</button>
            <button type="button" data-bfg-action="resolve-hit-and-run"><i class="fa-solid fa-person-running"></i> Resolve Hit and Run</button>
            <button type="button" data-bfg-action="teleport-hit-and-run"><i class="fa-solid fa-bolt"></i> Teleport Hit and Run</button>
            <button type="button" data-bfg-action="repair-systems"><i class="fa-solid fa-screwdriver-wrench"></i> Repair Systems</button>
            <button type="button" data-bfg-action="clear-blast-markers"><i class="fa-solid fa-broom"></i> Clear Blast Markers</button>
          {{/if}}
          <button type="button" data-bfg-action="brace-for-impact"><i class="fa-solid fa-shield"></i> Brace for Impact</button>
        </fieldset>
      </section>
    {{else}}
      {{#unless canManage}}<p class="notes bfg-turn-viewer-note">A Gamemaster must start the battle before phase actions become available.</p>{{/unless}}
    {{/if}}
  {{/if}}

  {{#if fleetsTab}}
    <section class="bfg-fleet-rosters" aria-label="Fleet assignments">
      {{#each fleetCards}}
        <article class="bfg-fleet-card{{#if active}} active{{/if}}">
          <header><strong>{{name}}</strong><span>{{shipCount}} assigned</span></header>
          <p class="notes"><i class="fa-solid fa-user"></i> {{controllerName}}</p>
        </article>
      {{/each}}
    </section>
    <button type="button" data-bfg-action="open-fleet-status" class="bfg-full-width"><i class="fa-solid fa-table-list"></i> Open Fleet Status</button>
    {{#if canManage}}
      <div class="bfg-turn-secondary-actions">
        <button type="button" data-bfg-action="assign-fleet"><i class="fa-solid fa-people-group"></i> Assign selected ship</button>
        <button type="button" data-bfg-action="clear-fleet"><i class="fa-solid fa-link-slash"></i> Clear assignment</button>
      </div>
      <div class="bfg-turn-secondary-actions">
        <button type="button" data-bfg-action="roll-leadership"><i class="fa-solid fa-dice-d6"></i> Roll selected Leadership</button>
        <button type="button" data-bfg-action="roll-all-leadership"><i class="fa-solid fa-dice"></i> Roll all unassigned</button>
      </div>
      <div class="bfg-turn-secondary-actions">
        <button type="button" data-bfg-action="edit-leadership"><i class="fa-solid fa-pen"></i> Edit selected Leadership</button>
        <button type="button" data-bfg-action="clear-leadership"><i class="fa-solid fa-eraser"></i> Clear selected Leadership</button>
      </div>
      <section class="bfg-squadron-management" aria-label="Squadron management">
        <header><strong>Squadrons</strong><span>Setup and membership</span></header>
        <div class="bfg-turn-secondary-actions">
          <button type="button" data-bfg-action="create-squadron"><i class="fa-solid fa-object-group"></i> Create from selected</button>
          <button type="button" data-bfg-action="assign-squadron"><i class="fa-solid fa-link"></i> Assign selected</button>
        </div>
        <div class="bfg-turn-secondary-actions">
          <button type="button" data-bfg-action="remove-squadron"><i class="fa-solid fa-link-slash"></i> Remove selected</button>
          <button type="button" data-bfg-action="disband-squadron"><i class="fa-solid fa-object-ungroup"></i> Disband squadron</button>
        </div>
        <div class="bfg-squadron-rosters">
          {{#each squadronFleetCards}}
            <div class="bfg-squadron-fleet">
              <strong>{{name}}</strong>
              {{#if hasSquadrons}}
                {{#each squadrons}}
                  <article class="bfg-squadron-card">
                    <header><strong>{{name}}</strong><span>{{typeLabel}}, {{memberCount}} ship(s)</span></header>
                    {{#if hasMembers}}<p>{{#each members}}{{name}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{else}}<p class="notes">No deployed members.</p>{{/if}}
                  </article>
                {{/each}}
              {{else}}<p class="notes">No squadrons configured.</p>{{/if}}
            </div>
          {{/each}}
        </div>
      </section>
    {{else}}<p class="notes bfg-turn-viewer-note">Only a Gamemaster can change fleet assignments.</p>{{/if}}
  {{/if}}

  {{#if toolsTab}}
    {{#if canManage}}
      <section class="bfg-turn-manager-controls" aria-label="Gamemaster tools">
        <div class="bfg-turn-secondary-actions">
          <button type="button" data-bfg-action="setup"><i class="fa-solid fa-pen-to-square"></i> Configure battle</button>
          <button type="button" data-bfg-action="end" {{#unless state.battleStarted}}disabled{{/unless}}><i class="fa-solid fa-flag-checkered"></i> End battle</button>
        </div>
        <button type="button" data-bfg-action="edit-critical-state" class="bfg-full-width"><i class="fa-solid fa-burst"></i> Edit selected critical effects</button>
        <div class="bfg-turn-secondary-actions">
          <button type="button" data-bfg-action="lock-selected-rotation"><i class="fa-solid fa-lock"></i> Lock selected rotation</button>
          <button type="button" data-bfg-action="unlock-selected-rotation"><i class="fa-solid fa-lock-open"></i> GM correction unlock</button>
        </div>
        <div class="bfg-turn-secondary-actions">
          <button type="button" data-bfg-action="edit-combat-state"><i class="fa-solid fa-heart-pulse"></i> Edit selected combat state</button>
          <button type="button" data-bfg-action="reset-combat-state"><i class="fa-solid fa-kit-medical"></i> Restore selected ship</button>
        </div>
        <button type="button" data-bfg-action="refresh-engines" class="bfg-full-width"><i class="fa-solid fa-wind"></i> Refresh Engine Effects</button>
        <button type="button" data-bfg-action="reset" class="bfg-danger-button bfg-full-width"><i class="fa-solid fa-rotate-left"></i> Reset battle and restore ships</button>
      </section>
    {{else}}<p class="notes bfg-turn-viewer-note">The Tools tab contains Gamemaster correction and battle-management controls.</p>{{/if}}
  {{/if}}
</div>
